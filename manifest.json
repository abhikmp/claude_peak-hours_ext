{
  "manifest_version": 3,
  "name": "ClaudeBuddy",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Usage, peak hours & outage status for Claude.",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://status.claude.com/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/connect-usage.js",
        "content/content-script-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "shared/accounts.js",
        "content/content-script-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/logo_16.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ClaudeBuddy",
    "default_icon": {
      "16": "icons/usage-green-16.png",
      "48": "icons/usage-green-48.png"
    }
  }
}
